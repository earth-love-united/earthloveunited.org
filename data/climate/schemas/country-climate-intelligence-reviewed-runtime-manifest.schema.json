{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://earthloveunited.org/schemas/climate/country-climate-intelligence-reviewed-runtime-manifest-1.0.0.json",
  "title": "Country Climate Intelligence reviewed production runtime manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "manifest_id", "release_id", "subject_commit_sha",
    "runtime", "review_request", "release_approval", "release_diff",
    "rollback_proof", "source_registry", "source_receipts",
    "artifact_pins", "review", "calculation_hash"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "manifest_id": {"type": "string", "minLength": 10},
    "release_id": {"type": "string", "minLength": 10},
    "subject_commit_sha": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "schema_path", "status", "production_runtime_release"],
      "properties": {
        "path": {"const": "data/climate/runtime/country-climate-intelligence.json"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "schema_path": {"const": "data/climate/schemas/country-climate-intelligence.schema.json"},
        "status": {"const": "production"},
        "production_runtime_release": {"const": true}
      }
    },
    "review_request": {"const": "data/climate/releases/country-climate-intelligence-v1/review-request.json"},
    "release_approval": {"const": "data/climate/releases/country-climate-intelligence-v1/release-approval.json"},
    "release_diff": {"const": "data/climate/releases/country-climate-intelligence-v1/reviewed-release-diff.json"},
    "rollback_proof": {"const": "data/climate/releases/country-climate-intelligence-v1/reviewed-rollback-proof.json"},
    "source_registry": {"$ref": "#/$defs/pin"},
    "source_receipts": {"$ref": "#/$defs/pin"},
    "artifact_pins": {
      "type": "array", "minItems": 20, "uniqueItems": true,
      "items": {"$ref": "#/$defs/pin"}
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "builder_id", "reviewer_id", "reviewed_at"],
      "properties": {
        "status": {"const": "reviewed"},
        "builder_id": {"type": "string", "minLength": 5},
        "reviewer_id": {"type": "string", "minLength": 5},
        "reviewed_at": {"type": "string", "format": "date-time"}
      }
    },
    "calculation_hash": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "pin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "pattern": "^[A-Za-z0-9._/-]+$"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
