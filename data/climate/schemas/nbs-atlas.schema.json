{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://earthloveunited.org/data/climate/schemas/nbs-atlas.schema.json",
  "title": "Earth Love United Nature-Based Solutions (NbS) Atlas Runtime Release",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "release_id",
    "profile",
    "workbench_commit",
    "calculation_hash",
    "atlas_totals",
    "categories",
    "mediterranean_seagrass_spotlight",
    "restoration_and_ecosystem_ledger",
    "hemp_and_biochar_industrial_ledger",
    "metrics_catalog",
    "sources",
    "countries"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "release_id": { "const": "nbs-atlas-public-noncommercial-v1" },
    "profile": { "const": "public_noncommercial" },
    "workbench_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "calculation_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "atlas_totals": {
      "type": "object",
      "required": [
        "canonical_v1_rows",
        "canonical_v1_sources",
        "public_noncommercial_rows_kept",
        "public_noncommercial_rows_withheld",
        "public_noncommercial_sources_admitted",
        "countries_in_slice",
        "withheld_by_category_and_reason"
      ]
    },
    "categories": { "type": "object" },
    "mediterranean_seagrass_spotlight": { "type": "object" },
    "restoration_and_ecosystem_ledger": { "type": "object" },
    "hemp_and_biochar_industrial_ledger": { "type": "object" },
    "metrics_catalog": { "type": "object" },
    "sources": { "type": "object" },
    "countries": { "type": "object" }
  }
}
